# Copy this file to .env for local testing. On Render, set these as
# Environment Variables in the service dashboard instead — never commit
# a real .env file.

# Telegram bot token (from @BotFather). Previously this was hardcoded in
# plaintext inside the client-side HTML on GitHub Pages — anyone viewing
# page source could read it. Moving it to a server env var is a real
# security fix, not just a reliability one.
TG_TOKEN=your_bot_token_here

# Comma-separated chat/group IDs to send alerts to.
TG_RECIPIENTS=1742837981,-1004304777856

# Max $ risk per trade used for position sizing.
MAX_RISK_USD=35

# Margin ($ ) you actually commit per trade — used to suggest leverage.
MARGIN_PER_TRADE_USD=150

# Flag (not block) any suggested leverage above this.
MAX_SENSIBLE_LEVERAGE=50

# How often the 1D scan rebuilds the watchlist (ms). Default 30 min, to
# match the 30min confirmation candle — a new 1D signal shouldn't sit
# unseen for up to an hour before even making it onto the watchlist.
SCAN_INTERVAL_MS=1800000

# How often the 30min confirmation loop re-checks the watchlist (ms).
# On the browser version this was tied to the same 1-hour timer as the
# scan. On a server there's no reason to wait that long to notice a
# candle closed — checking every 5 minutes costs nothing and gets you
# alerted sooner. Lower = faster alerts, more Binance API calls.
CONFIRM_INTERVAL_MS=300000

# Port the server listens on. Render sets this automatically — only
# needed for local testing.
PORT=3000

# Optional: path to a mounted Render Disk for durable trade-log/state
# storage across restarts. Leave unset to use the local data/ folder
# (resets on every Render restart/redeploy — see README.md).
# DATA_DIR=/var/data

# ── Bybit Demo Trading (auto-execution) ──────────────────────────────
# Generate these from Bybit → switch to "Demo Trading" → avatar → API.
# A key created under Demo Trading ONLY works against api-demo.bybit.com
# — it cannot touch a live balance even if BYBIT_AUTO_TRADE is on.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Must be the literal string "true" to actually place orders. Any other
# value (including unset) keeps the bot alert-only, same as before —
# this is an opt-in, not automatic just because keys are present.
BYBIT_AUTO_TRADE=false

# Secret that unlocks admin actions on the dashboard (mark WIN/LOSS, force scan)
# and the Telegram test endpoint. Anyone WITHOUT it can still view everything.
# Use a long random value. If unset, admin actions are disabled.
ADMIN_KEY=

# Skip confirmations whose 30m candle closes within this many hours of the
# daily close (00:00 UTC = 01:00 Lagos). 0 disables. Default 2.
END_OF_DAY_CUTOFF_HOURS=2
